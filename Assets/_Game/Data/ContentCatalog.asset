  - {fileID: 11400000, guid: bea5d069f3976484f8c8556fc1d6f30a, type: 2}
  - {fileID: 11400000, guid: 32159e9ff97b17f4e98c3fc9b3f2c9ac, type: 2}
  - {fileID: 11400000, guid: b88992e7edf7d7e4f8dd22e339feaa6a, type: 2}
  - {fileID: 11400000, guid: 657d930a39abf4c43976ba7d99414429, type: 2}
  - {fileID: 11400000, guid: 11e09cc228b06144798ac435aa5391d1, type: 2}
  - {fileID: 11400000, guid: 639fa4c5ff2257b4f9808e7b74c8b9a5, type: 2}
  - {fileID: 11400000, guid: dda5d7b034e9041438ad8baee2cc9e2b, type: 2}
  - {fileID: 11400000, guid: 158c0d5bd8fa1d641bc54173aa14f386, type: 2}
  - {fileID: 11400000, guid: 99cf8f1b52b18404ba7316e386ef6a6b, type: 2}
  - {fileID: 11400000, guid: 1d0e6477a6135b34c8eec40894ee23f4, type: 2}
  - {fileID: 11400000, guid: 497ba825030959043a2de7adeb6831a9, type: 2}
  - {fileID: 11400000, guid: 3866656eb58e4bc49b755bb6d78ccf60, type: 2}
  - {fileID: 11400000, guid: 4d0beb61f3c78d446bf674ccace4cab6, type: 2}
  - {fileID: 11400000, guid: 3f11094e58f45464eb24e9e49e21b51a, type: 2}
  - {fileID: 11400000, guid: cb29f834e391c80459df7a274f81e828, type: 2}
  - {fileID: 11400000, guid: 264f6913061f3d64dbb97acbb20d997a, type: 2}
  - {fileID: 11400000, guid: d0a903be40dacad43986402997eb8817, type: 2}
  shifts:
  - {fileID: 11400000, guid: 2df05cbafd5e7184697faf585738a659, type: 2}
  - {fileID: 11400000, guid: e03b1e956d23ed3438d57a58ed89fba9, type: 2}
  - {fileID: 11400000, guid: ba736cf0fe3ac904ab5eca8f4b30655c, type: 2}
  - {fileID: 11400000, guid: ba29911cae3cd3c47ac9c1f6a012d07e, type: 2}
  - {fileID: 11400000, guid: d4329b09a63175a4280041efd8cc9125, type: 2}
  - {fileID: 11400000, guid: 5e3f013d4015d094dbc4eb18bb9f7f95, type: 2}
  news:
  - after: 0
    text: Night Window 3 reopens after its last receptionist was "reassigned".
    when: []
  - after: 0
    text: 'LATTICE: humans in stolen bio-suits seen near the Tower. Citizens urged
      to report anyone who blinks.'
    when: []
  - after: 0
    text: Kesh to wear five colours this cycle. Moon-readers 80% excited.
    when: []
  - after: 1
    text: INVADER CAUGHT AT TOWER. New night receptionist "a natural", says Lattice.
    when:
    - caught
  - after: 1
    text: 'Unregistered being sighted on floor 14. Lattice: "An isolated incident.
      Stay 60% content."'
    when:
    - invader
  - after: 1
    text: Citizen detained in error at the Tower released "mostly unharmed".
    when:
    - wrongful
  - after: 1
    text: 'Lattice reminds citizens: humans blink. Do not blink.'
    when: []
  - after: 1
    text: 'Earth signal detected again. Lattice: "Nothing to worry about. Do not
      listen to it."'
    when: []
  - after: 1
    text: 'Spore-meal up 3%: "a temporary harvest wobble", says the Food Lattice.'
    when: []
  - after: 2
    text: Tower arrests rise. "The night window is our wall," says Supervisor Graav.
    when:
    - caught
  - after: 2
    text: Floor 9 cleaners report "a smell of sweat". Audit office sealed for the
      night.
    when:
    - invader
  - after: 2
    text: 'Family of wrongly arrested clerk asks: "Who checks the checkers?"'
    when:
    - wrongful
  - after: 2
    text: 'Forged IDs flood the markets. Lattice: "Read every name letter by letter."'
    when: []
  - after: 2
    text: Elder Sunnek of the Ammaru turns 300. Celebrations 70% muted.
    when: []
  - after: 2
    text: Kesh turned an "unusual" shade last night. Moon-readers "not concerned".
    when: []
  - after: 3
    text: Block 22 family taken in for a "routine gill inspection". Neighbours 90%
      relieved.
    when:
    - flag:reported-22b
  - after: 3
    text: Block 22 resident complains the Lattice "ignores perfectly good tips".
    when:
    - flag:protected-22b
  - after: 3
    text: Night Window 3 now catches more invaders than windows 1 and 2 combined.
    when:
    - caught
  - after: 3
    text: 'Invader seen laughing in a Tower lift. Lattice: "Do not laugh back."'
    when:
    - invader
  - after: 3
    text: 'LATTICE: There is no basement in the Lattice Tower. Please stop asking
      about the basement.'
    when: []
  - after: 3
    text: 'Humans can''t even write a date, says expert: "They put dots in it."'
    when: []
  - after: 3
    text: Moon-readers confirm Kesh "will be whatever colour it is".
    when: []
  - after: 4
    text: Invader-free week at the Tower! Where are the invaders now? "Processed,"
      says the Lattice.
    when:
    - caught
  - after: 4
    text: 'Human "refugees" reported in the Moss Deeps. Lattice: "There are no refugees.
      Only invaders."'
    when:
    - invader
  - after: 4
    text: From tomorrow, Ammaru visitors to the Tower need a blue clan stamp.
    when: []
  - after: 4
    text: Maintenance worker taken for questioning after humming "the basement song"
      in a lift.
    when: []
  - after: 4
    text: Breathing on glass is now "a civic duty", says the Lattice.
    when: []
  - after: 5
    text: Lattice medal shortlist includes "a certain night receptionist".
    when:
    - caught
  - after: 5
    text: Fake glow spots found in a Tower bin. "Someone is getting sloppy," says
      Graav.
    when:
    - invader
  - after: 5
    text: UV lamps now on sale to night staff. "Holograms don't lie."
    when: []
  - after: 5
    text: Forgers move on to printed holograms, warns the Lattice.
    when: []
  - after: 5
    text: Plo frill-crowns win the cycle's crest parade for the 9th time.
    when: []
  - after: 6
    text: 'Lattice: invader numbers "stable". Basement numbers "not a thing".'
    when: []
  - after: 6
    text: Kesh to go dark for one night next cycle. Citizens told to "just know"
      its colour.
    when: []
  - after: 6
    text: Night Window 3 receptionist's record "under review".
    when: []
  messages:
  - id: hearing
    after: -1
    from: Supervisor Graav
    text: 'Three strikes this act. Disciplinary hearing held in your absence: fined
      30 shards. Your slate is clean. It will not be clean twice.'
    when:
    - hearing
    choices: []
  - id: clinic
    after: -1
    from: Lattice Clinic
    text: Your sibling Sel was admitted last night with gill fever. Sel is resting
      at home now. The 50-shard bill is due tonight.
    when:
    - sel-hospital
    choices: []
  - id: landlord-debt
    after: -1
    from: Landlord Mott
    text: You owe me rent, Receptionist. I am 0% patient. Pay, or the Lattice hears
      about it.
    when:
    - debt
    choices: []
  - id: intro-lattice
    after: 0
    from: Civic Lattice
    text: Welcome to the Lattice Tower, Receptionist Ilo. Report to Night Window
      3 at 20:00. You are paid per correct decision; errors are deducted. Glory to
      the Lattice.
    when: []
    choices: []
  - id: intro-sel
    after: 0
    from: Sel
    text: BIG NIGHT!! You're going to be the best window person ever. I'm 90% proud
      and 10% coughing. Don't worry about the coughing. Will you bring me a story
      about a weird visitor?
    when: []
    choices:
    - text: I promise. Get some sleep.
      reply: YES. 100% asleep. (Not really.)
      flag: promised-stories
      loyalty: 0
      mercy: 0
      shards: 0
    - text: Work is work, Sel. Rules are rules.
      reply: ...okay. 60% okay.
      flag: rules-first
      loyalty: 1
      mercy: 0
      shards: 0
  - id: graav-1-good
    after: 1
    from: Supervisor Graav
    text: A clean first night. Don't let it go to your crest.
    when:
    - perfect
    choices: []
  - id: graav-1
    after: 1
    from: Supervisor Graav
    text: Mistakes on your first night. Everyone makes them once. Make them once.
    when:
    - '!perfect'
    choices: []
  - id: sel-1
    after: 1
    from: Sel
    text: Did you see one?? A real human?? Tuvo at school says they have hair EVERYWHERE
      and five fingers on each hand. FIVE.
    when: []
    choices: []
  - id: landlord-1
    after: 1
    from: Landlord Mott
    text: Rent is due every night, Receptionist. The Lattice pays you; you pay me.
      Simple.
    when:
    - broke
    choices: []
  - id: sel-2-sick
    after: 2
    from: Sel
    text: I'm fine. I'm 40% fine. The cough is louder at night, but I can hide it
      under the pillow.
    when:
    - meds-missed
    choices: []
  - id: sel-2
    after: 2
    from: Sel
    text: The new medicine tastes like burnt glow-moss. I'm 70% better! Did anyone
      laugh at your jokes yet?
    when:
    - '!meds-missed'
    choices: []
  - id: graav-2
    after: 2
    from: Supervisor Graav
    text: You arrested a citizen. Their family filed a complaint with my office.
      Read the rulebook. Then read it again.
    when:
    - wrongful
    choices: []
  - id: neighbour-2
    after: 2
    from: Neighbour Vaun
    text: Receptionist. You work for the Lattice, yes? The family in 22-B never shows
      their gills. Never. I've been watching. Will you report them?
    when: []
    choices:
    - text: I'll pass it on to the Lattice.
      reply: Good. Someone has to.
      flag: reported-22b
      loyalty: 1
      mercy: 0
      shards: 0
    - text: Leave them alone. Gills are private.
      reply: Hmph. On your crest be it.
      flag: protected-22b
      loyalty: 0
      mercy: 1
      shards: 0
  - id: sel-3-sick
    after: 3
    from: Sel
    text: Don't be mad. I fainted at school. The nurse says I need my medicine every
      night. Every night, Ilo.
    when:
    - sel-sick
    choices: []
  - id: sel-3
    after: 3
    from: Sel
    text: I drew you at your window! You're the one with the big important face.
      Graav is the grumpy cloud.
    when:
    - '!sel-sick'
    choices: []
  - id: graav-3
    after: 3
    from: Supervisor Graav
    text: Records is closed tomorrow. Make them breathe on the glass. Citizens leave
      it clear.
    when: []
    choices: []
  - id: w3-caught
    after: 4
    from: Unknown
    text: "You're good at spotting us. Do you know where they take the ones you catch?
      Look down, receptionist. \u2014 W3"
    when:
    - caught
    choices:
    - text: Delete the message.
      reply: (The message is gone. The feeling isn't.)
      flag: w3-deleted
      loyalty: 1
      mercy: 0
      shards: 0
    - text: 'Reply: "Who is this?"'
      reply: "Someone who sat at Window 3 once. Like you. \u2014 W3"
      flag: w3-replied
      loyalty: 0
      mercy: 1
      shards: 0
  - id: w3-missed
    after: 4
    from: Unknown
    text: "Some of us walked right past you. Maybe you noticed, maybe you didn't.
      Either way: thank you. Look down, receptionist. \u2014 W3"
    when:
    - '!caught'
    choices:
    - text: Delete the message.
      reply: (The message is gone. The feeling isn't.)
      flag: w3-deleted
      loyalty: 1
      mercy: 0
      shards: 0
    - text: 'Reply: "Who is this?"'
      reply: "Someone who sat at Window 3 once. Like you. \u2014 W3"
      flag: w3-replied
      loyalty: 0
      mercy: 1
      shards: 0
  - id: sel-4
    after: 4
    from: Sel
    text: A Lattice man came to school and asked if anyone's family blinks. Everyone
      laughed. I didn't laugh. Is that bad?
    when: []
    choices: []
  - id: graav-4
    after: 4
    from: Supervisor Graav
    text: 'Your first week is done. Tomorrow the clan rule starts: Ammaru need a
      blue stamp. Know the clans better than they do.'
    when: []
    choices: []
  - id: graav-5
    after: 5
    from: Supervisor Graav
    text: Tomorrow the forgers start faking holograms. A UV lamp shows the fakes.
      The Lattice store sells them. I'd buy one.
    when: []
    choices: []
  - id: sel-5
    after: 5
    from: Sel
    text: Is it true the humans' planet is dying? Tuvo says they come here because
      there's nowhere else. Tuvo says a lot of things.
    when: []
    choices: []
  - id: sel-6
    after: 6
    from: Sel
    text: You came home late again. I saved you some spore-meal. It's 50% spore-meal
      and 50% my drawing of you.
    when: []
    choices: []
  upgrades:
  - id: uv-lamp
    name: UV lamp
    text: 'Shows genuine holograms: real ones glow with rings, printed fakes stay
      flat.'
    price: 60
    unlockShift: 6
    tool: uv
  tutorial:
    shift: 1
    visitors:
    - kind: OrdinaryCitizen
      tells: []
      violation: 
    - kind: ClumsyHuman
      tells:
      - RoundPupils
      - SaysFine
      violation: 
    - kind: RuleBreakerCitizen
      tells: []
      violation: Expired
    steps:
    - visitor: 1
      target: window
      wait: tap
      text: 'Welcome to Night Window 3! Every visitor says they''re a citizen of
        Vel''Tara. Some are HUMANS hiding in stolen bio-suits. Your job: spot them.'
    - visitor: 1
      target: id
      wait: tap
      text: 'This is their Civic Lattice ID. First check: does the PHOTO match the
        face at the window? Same clan, same face, slit pupils.'
    - visitor: 1
      target: slip
      wait: tap
      text: This is their appointment slip. The NAME must match the ID exactly, and
        the FLOOR must be in the ID's floor access.
    - visitor: 1
      target: topbar
      wait: tap
      text: 'Up here: tonight''s date, the clock and your score. An ID that EXPIRES
        before tonight''s date is no good.'
    - visitor: 1
      target: questions
      wait: ask
      text: "You can ask each visitor 3 questions. Pick one now. Try \u201CHow are
        you feeling tonight?\u201D"
    - visitor: 1
      target: log
      wait: tap
      text: "Every answer goes in this log. Citizens state a mood, like \u201CI am
        60% content.\u201D"
    - visitor: 1
      target: rulebook
      wait: tap
      text: Not sure what's normal? The RULEBOOK lists how citizens look and behave,
        and every desk rule.
    - visitor: 1
      target: letin
      wait: letin
      text: 'Matching papers, a matching face, a citizen''s answer. This is a citizen:
        press LET IN.'
    - visitor: 2
      target: window
      wait: tap
      text: 'Look closely at this visitor''s eyes: ROUND pupils! Every citizen has
        vertical slit pupils.'
    - visitor: 2
      target: question:greeting
      wait: ask:greeting
      text: Ask how they're feeling, and read the answer.
    - visitor: 2
      target: log
      wait: tap
      text: "\u201CFine\u201D instead of a mood: another human slip. Humans also
        blink, sweat, and show five fingers."
    - visitor: 2
      target: security
      wait: security
      text: This is a human in a suit. HOLD Call Security until the bar fills.
    - visitor: 3
      target: id
      wait: tap
      text: This one looks like a real citizen. But compare the ID's EXPIRES date
        with tonight's date at the top.
    - visitor: 3
      target: away
      wait: away
      text: The ID has expired. A real citizen who breaks a rule is TURNED AWAY,
        never arrested.
    - visitor: 4
      target: decisions
      wait: tap
      text: 'That''s the job. Humans: CALL SECURITY. Rule-breakers: TURN AWAY. Everyone
        else: LET IN. The rest of tonight is up to you!'

    when:
    - flag:inspector2:security
    choices: []
  - id: sel-21
    after: 21
    from: Sel
    text: I'm drawing everyone at the Tower. Duun has the best face. Graav has the
      worst face. You have a nice face. A weird nice face.
    when: []
    choices: []
  - id: clinic-scan
    after: 22
    from: Lattice Clinic
    text: "Routine gill scan for Tower staff, Receptionist Ilo: \"Gill lines unusually
      regular. Scar tissue at the neck consistent with\u2026\" The rest of the report

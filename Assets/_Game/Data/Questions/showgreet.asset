  data:
    id: showgreet
    text: Show me how you greet your elder.
    kind: Personal
    effect: 
    reveals: WrongClanLore
    citizen:
    - '*performs {greeting}*'
    - 'Like this: {greeting}.'
    - '{greeting}. Satisfied?'
